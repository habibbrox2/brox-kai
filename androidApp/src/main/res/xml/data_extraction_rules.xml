<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="kai_secure_prefs.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
        <exclude domain="database" path="conversations.db" />
        <exclude domain="database" path="conversations.db-journal" />
        <exclude domain="database" path="conversations.db-wal" />
        <exclude domain="database" path="conversations.db-shm" />
